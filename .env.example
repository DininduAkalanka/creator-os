# Copy to .env.local (never commit real values). Only variables the code reads are listed.

# Public URL of the marketing site (used for absolute links and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only for the launched production site. Anything else keeps search engines out
# (robots.txt disallows everything and pages carry noindex).
SITE_INDEXABLE=false

# --- apps/api (put API settings in apps/api/.env.local; `pnpm dev` reads that file) ---
# Port for the REST API. A whole number from 1 to 65535; anything else stops start-up.
API_PORT=4000

# --- Local database and S3 (put these in .env at the repo root; `docker compose` reads that file) ---
# Pick your own long random values. They're used on the database's first start only; to change
# them later, run `docker compose down --volumes` (this deletes the local data).
POSTGRES_PASSWORD=
CREATOROS_MIGRATOR_PASSWORD=
CREATOROS_APP_PASSWORD=
CREATOROS_AUTH_PASSWORD=
# The local S3 store (RustFS). The secret must be at least 8 characters.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- packages/db (put these in packages/db/.env.local; `pnpm db:migrate` and `pnpm db:seed` read it) ---
# One URL per database role (PLAN.md §3.1), with the matching password from .env above.
# The migrator runs migrations; app_user is what the API and worker use; auth_service is sign-in (M4).
MIGRATOR_DATABASE_URL=postgres://creatoros_migrator:<password>@127.0.0.1:5432/creatoros
DATABASE_URL=postgres://app_user:<password>@127.0.0.1:5432/creatoros
AUTH_DATABASE_URL=postgres://auth_service:<password>@127.0.0.1:5432/creatoros
