# Copy to .env.local (never commit real values). Only variables the code reads are listed.

# Public URL of the marketing site (used for absolute links and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only for the launched production site. Anything else keeps search engines out
# (robots.txt disallows everything and pages carry noindex).
SITE_INDEXABLE=false

# --- apps/api (put API settings in apps/api/.env.local; `pnpm dev` reads that file) ---
# Port for the REST API. A whole number from 1 to 65535; anything else stops start-up.
API_PORT=4000
