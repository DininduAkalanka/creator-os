# Hand-off artifacts: apply them, then delete. Git holds the result.
/*.patch
/*.zip

# Secrets
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json

# Python
__pycache__/
*.pyc

# Node, pnpm, Turborepo, Next.js
node_modules/
.turbo/
.next/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/
*.log

# Creator media and data: never commit footage, audio, transcripts or creator names
data/
*.mp4
*.mov
*.mkv
*.m4a
*.wav
*.mp3
*.opus
