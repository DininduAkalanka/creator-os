{
  "name": "@creatoros/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The single source of state enums and transitions, zod schemas, error codes, the response envelope, pagination, IDs and the OpenAPI helpers. Imports nothing internal.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@creatoros/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@creatoros/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
