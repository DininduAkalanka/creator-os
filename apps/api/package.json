{
  "name": "@creatoros/api",
  "version": "0.0.0",
  "private": true,
  "description": "The REST API under /api/v1 (NestJS 12, ESM)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "creatoros-dev-node",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@creatoros/config": "workspace:*",
    "@nestjs/testing": "12.6.0",
    "@types/node": "26.6.7",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
